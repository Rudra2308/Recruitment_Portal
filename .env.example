# ---------------------------------------------------------------------------
# Malati Group Recruitment Portal — environment configuration
# Copy to .env.local and fill in. Everything except the Google credentials and
# JWT secret is optional for local development.
# ---------------------------------------------------------------------------

# Public base URL used for QR codes, emails and canonical links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Google Sheets / Drive -------------------------------------------------
# The spreadsheet ID is the long value between /d/ and /edit in the sheet URL.
GOOGLE_SPREADSHEET_ID=
# Service account JSON key. Paste the full JSON on one line, or base64 encode
# the file contents and paste that. Never commit this value.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Drive folder where CVs are stored privately. Share the folder with the
# service account as Editor.
GOOGLE_DRIVE_FOLDER_ID=

# --- Admin authentication --------------------------------------------------
# Generate with: npm run hash-password -- "your-strong-password"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
ADMIN_EMAIL=admin@malatigroup.com
ADMIN_PASSWORD_HASH=

# --- Email (optional) ------------------------------------------------------
# Leave EMAIL_ENABLED=false to run the portal without SMTP. Applications
# still submit and are stored; only notifications are skipped.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HR_EMAIL=hrandadmin@malatigroup.com

# --- Optional limits -------------------------------------------------------
CV_MAX_MB=4

# --- Cloudinary Storage (Recommended: 25GB free, NO credit card needed) ---
# Option A: Paste the single CLOUDINARY_URL from your Cloudinary Dashboard:
CLOUDINARY_URL=
# Option B: Or paste the 3 individual values:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudflare R2 Storage (Alternative: 10GB free, card required) ---------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=malati-recruitment-cvs
